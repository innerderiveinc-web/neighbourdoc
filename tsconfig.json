{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@neighbourdoc/shared": ["packages/shared/src/index.ts"],
      "@neighbourdoc/shared/*": ["packages/shared/src/*"],
      "@neighbourdoc/api": ["packages/api/src/index.ts"],
      "@neighbourdoc/api/*": ["packages/api/src/*"],
      "@neighbourdoc/ui": ["packages/ui/src/index.ts"],
      "@neighbourdoc/ui/*": ["packages/ui/src/*"],
      "@neighbordoc/shared": ["packages/shared/src/index.ts"],
      "@neighbordoc/shared/*": ["packages/shared/src/*"],
      "@neighbordoc/api": ["packages/api/src/index.ts"],
      "@neighbordoc/api/*": ["packages/api/src/*"],
      "@neighbordoc/ui": ["packages/ui/src/index.ts"],
      "@neighbordoc/ui/*": ["packages/ui/src/*"]
    },
    "noEmit": true
  },
  "include": [
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "apps/admin/**/*.ts",
    "apps/admin/**/*.tsx",
    "apps/doctor/**/*.ts",
    "apps/doctor/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["apps/mobile", "node_modules", "**/node_modules", "**/.next", "dist"]
}
